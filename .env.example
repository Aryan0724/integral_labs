# Canonical site URL (used for metadata, sitemap, JSON-LD). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://labs.integralgroups.in

# Search engine site verification (from Google Search Console / Bing Webmaster)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Analytics (all optional; site ships zero analytics JS until IDs are set)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=

# Contact enquiries — email channel (Resend). Verify a domain in Resend and
# set EMAIL_FROM to e.g. "Integral Labs <enquiries@integralgroups.in>".
DISCORD_WEBHOOK_URL=
RESEND_API_KEY=
CONTACT_EMAIL_TO=
EMAIL_FROM=

# Admin Authentication & Sessions
ADMIN_PASSWORD=change_this_in_production
ADMIN_SESSION_SECRET=min_32_characters_random_cryptographic_secret_here
